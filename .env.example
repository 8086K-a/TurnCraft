# LLM 配置
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here

# 业务系统 API
COMMERCE_API_BASE_URL=http://127.0.0.1:8000

# 数据库（Docker 内部用 mysql+pymysql，本地用 mysql+aiomysql）
DATABASE_URL=mysql+aiomysql://root:12345678@mysql:3306/edu_prod?charset=utf8mb4

# 应用端口
APP_HOST=0.0.0.0
APP_PORT=18082

# MySQL（docker-compose 用）
MYSQL_ROOT_PASSWORD=12345678
MYSQL_DATABASE=edu_prod
MYSQL_PORT=3306
